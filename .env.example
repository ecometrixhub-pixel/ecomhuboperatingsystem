# Copy this file to .env for local testing. On Vercel add the same keys under
# Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API (Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase → Project Settings → API Keys
# Publishable key (sb_publishable_...) — or the legacy "anon" key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. Server only, never share it.
SUPABASE_SECRET_KEY=

# Optional: your live address, e.g. https://ecomhub-os.vercel.app (used in invite links)
SITE_URL=
